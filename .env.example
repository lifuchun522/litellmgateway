# 轻量级 LLM 网关 · 本地环境变量样例
#
# 用法：复制为 .env 后按需修改；.env 不进版本库（见 .gitignore）。
# 敏感值只从环境变量注入，禁止写进 yml 或代码。

# ---- 数据源（application-local.yml / application-mysql.yml 都读这三个）----
# PostgreSQL 本地：jdbc:postgresql://localhost:5432/jd_openapi?currentSchema=public&stringtype=unspecified
# MySQL 本地：     jdbc:mysql://localhost:3306/jd_openapi?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=GMT%2B8
LLMGATEWAY_DB_URL=
LLMGATEWAY_DB_USER=postgres
LLMGATEWAY_DB_PASSWORD=

# ---- Spring profile ----
# local  : 本机 PostgreSQL（application-local.yml）
# mysql  : 本机 MySQL 8（application-mysql.yml）
# druid  : 基线口径，数据源细节在 application-druid.yml
SPRING_PROFILES_ACTIVE=local

# ---- Shiro rememberMe 加密密钥（必须固定，否则重启后旧 Cookie 解密失败）----
# 生成方式（一次性，输出 24 位 Base64）：
#   java -cp <shiro-core.jar> org.apache.shiro.crypto.AesCipherService
# 或直接用任意 128bit 随机数的 Base64，例如 openssl rand -base64 16
SHIRO_CIPHER_KEY=

# ---- Druid 监控台（生产必须改掉或关闭）----
DRUID_LOGIN_USERNAME=
DRUID_LOGIN_PASSWORD=
